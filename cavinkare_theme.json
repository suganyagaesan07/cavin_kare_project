{
  "name": "CavinKare FMCG Pink Blue",
  "dataColors": [
    "#F472B6",
    "#1E6FD9",
    "#8E6BCB",
    "#4DB8F5",
    "#F9A8D4",
    "#1565C0",
    "#C4A5E8",
    "#FB7185"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2A5A",
  "tableAccent": "#F472B6",
  "good": "#1E6FD9",
  "neutral": "#8E6BCB",
  "bad": "#E11D74",
  "maximum": "#1E6FD9",
  "center": "#F9A8D4",
  "minimum": "#FDE8F0",
  "textClasses": {
    "callout": {
      "fontSize": 32,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2A5A"
    },
    "title": {
      "fontSize": 16,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2A5A"
    },
    "header": {
      "fontSize": 14,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2A5A"
    },
    "label": {
      "fontSize": 14,
      "fontFace": "Segoe UI",
      "color": "#1F2A5A"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#FDE8F0" } },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
