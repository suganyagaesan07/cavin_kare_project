        "categoryAxis": [
          {
            "show": true,
            "fontSize": 14,
            "fontFamily": "Segoe UI",
            "labelColor": { "solid": { "color": "#1F2A5A" } },
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontSize": 14,
            "fontFamily": "Segoe UI",
            "labelColor": { "solid": { "color": "#1F2A5A" } },
            "showAxisTitle": false,
            "gridlineColor": { "solid": { "color": "#F9D0E2" } }
          }
        ],
        "y2Axis": [
          {
            "show": true,
            "fontSize": 14,
            "labelColor": { "solid": { "color": "#1F2A5A" } }
          }
        ],
        "legend": [
          {
            "show": true,
            "fontSize": 14,
            "labelColor": { "solid": { "color": "#1F2A5A" } }
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 16,
            "fontColor": { "solid": { "color": "#1F2A5A" } },
            "background": { "solid": { "color": "#FFF5F9" } }
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFF5F9" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#F9D0E2" } },
            "radius": 12
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 32,
            "color": { "solid": { "color": "#1F2A5A" } }
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "fontSize": 14,
            "color": { "solid": { "color": "#1F2A5A" } }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontSize": 14,
            "fontColor": { "solid": { "color": "#1F2A5A" } }
          }
        ],
        "items": [
          {
            "fontSize": 14,
            "fontColor": { "solid": { "color": "#1F2A5A" } },
            "background": { "solid": { "color": "#FFFFFF" } }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontSize": 14,
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#F472B6" } }
          }
        ],
        "values": [
          {
            "fontSize": 14,
            "fontColorPrimary": { "solid": { "color": "#1F2A5A" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "fontColorSecondary": { "solid": { "color": "#1F2A5A" } },
            "backColorSecondary": { "solid": { "color": "#FFF5F9" } }
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "fontSize": 14,
            "color": { "solid": { "color": "#FFFFFF" } }
          }
        ]
      }
    },
    "pieChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "fontSize": 14,
            "color": { "solid": { "color": "#FFFFFF" } }
          }
        ]
      }
